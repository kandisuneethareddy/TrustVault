# TrustVault Environment Configuration Example
# Copy this file to .env and fill in your secure secrets.
# DO NOT commit real secrets to GitHub!

PORT=4000
NODE_ENV=production

# Cryptographic Keys (Generate fresh 32+ character secrets for production)
JWT_SECRET=replace_with_a_secure_random_64_char_hex_key_for_production
STORAGE_ENCRYPTION_KEY=replace_with_a_32_byte_aes_encryption_key!

# Token Expiration
JWT_EXPIRES_IN=2h

